{
  "name": "complete-web-app-boilerplate",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm run build:shared && turbo run dev --env-mode=loose",
    "dev:web": "turbo run dev --env-mode=loose --filter=@complete-web-app-boilerplate/web",
    "dev:admin": "pnpm run build:shared && pnpm run build:sdk && turbo run dev --env-mode=loose --filter=@complete-web-app-boilerplate/admin --filter=@complete-web-app-boilerplate/api --filter=@complete-web-app-boilerplate/shared",
    "dev:api": "pnpm run build:shared && turbo run dev --env-mode=loose --filter=@complete-web-app-boilerplate/api --filter=@complete-web-app-boilerplate/shared",
    "dev:email-template": "turbo run dev --env-mode=loose --filter=@complete-web-app-boilerplate/email-template",
    "start:api": "pnpm --filter @complete-web-app-boilerplate/api start",
    "api:generate:module": "pnpm --filter @complete-web-app-boilerplate/api generate:module",
    "api:generate:openapi": "turbo run generate:openapi --filter=@complete-web-app-boilerplate/api",
    "sdk:generate": "turbo run generate --filter=@complete-web-app-boilerplate/sdk",
    "sdk:build": "turbo run build --filter=@complete-web-app-boilerplate/sdk",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@complete-web-app-boilerplate/api",
    "build:shared": "turbo run build --filter=@complete-web-app-boilerplate/shared",
    "build:sdk": "turbo run build --filter=@complete-web-app-boilerplate/sdk",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "turbo": "2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
