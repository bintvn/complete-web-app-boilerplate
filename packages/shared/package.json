{
  "name": "@complete-web-app-boilerplate/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core/validation": {
      "types": "./dist/core/validation.schema.d.ts",
      "import": "./dist/core/validation.schema.js"
    },
    "./core/modules/*": {
      "types": "./dist/core/modules/*/schema.d.ts",
      "import": "./dist/core/modules/*/schema.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/schema.d.ts",
      "import": "./dist/modules/*/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "typescript": "~6.0.3",
    "zod": "4.6.7"
  }
}
