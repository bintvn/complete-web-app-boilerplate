{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "generate:openapi": {
      "dependsOn": ["^build"],
      "outputs": ["dist/openapi.json"]
    },
    "generate": {
      "dependsOn": ["@complete-web-app-boilerplate/api#generate:openapi"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local", ".env.production", ".env.production.local"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
